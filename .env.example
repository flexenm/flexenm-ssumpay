PORT=3000
NODE_ENV=development

# DB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ssumpay

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Admin JWT (별도 시크릿)
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# 이메일 (비밀번호 찾기)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CORS 허용 오리진 (콤마 구분)
ALLOWED_ORIGINS=http://localhost:5173,https://ssumpay.com

# FlexTV 콜백 (나중에)
FLEXTV_API_URL=
FLEXTV_API_KEY=