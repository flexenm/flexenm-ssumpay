PORT=3000
NODE_ENV=development

# DB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ssumpay

# JWT (access token 전용 — 실제 세션 연장/무효화는 Redis의 refresh token이 담당)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h

# Admin JWT (별도 시크릿)
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# Redis (rate limiter 카운터 + refresh token 저장소 — 여러 인스턴스에서 공유용)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 이메일 (비밀번호 찾기)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CORS 허용 오리진 (콤마 구분) — 라우트 그룹별로 분리한다.
# 인증이 HttpOnly 쿠키가 되면서 두 SPA 가 같은 API 호스트를 공유하므로, 하나로 합쳐 두면
# 사용자 사이트의 XSS 가 credentials 를 실어 /admin/* 을 호출할 수 있다.
ALLOWED_ORIGINS_USER=http://localhost:5173
ALLOWED_ORIGINS_ADMIN=http://localhost:5174

# FlexTV 콜백 (나중에)
FLEXTV_API_URL=
FLEXTV_API_KEY=